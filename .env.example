POSTGRES_DB=flood_intelligence
POSTGRES_USER=flood
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
API_PORT=8000
GISTDA_API_KEY=
GISTDA_API_BASE_URL=
PHOTO_STORAGE_DIRECTORY=/data/flood-report-photos
PHOTO_MAX_BYTES=8388608
CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
ROUTING_PROVIDER=valhalla
# Use http://localhost:8002 when FastAPI runs directly on the host.
# Docker Desktop containers reach the independently managed host service here.
VALHALLA_URL=http://host.docker.internal:8002
VALHALLA_TIMEOUT_SECONDS=10
PUBLIC_ROUTE_IMPACT_RADIUS_METERS=300
ROUTE_IMPACT_PUBLIC_LOOKBACK_HOURS=24
ROUTE_IMPACT_GISTDA_PERIOD=3DAYS
